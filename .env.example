# Absolute origin used for canonical URLs, OG tags, sitemap and robots.
# Leave unset in production — it falls back to https://www.gamcs.in.
# Set it on preview deployments so they point at themselves.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# TODO(business): supply the real property ID. Until it is set, no analytics
# script is loaded at all. A GA4 measurement ID is public by design — never
# put an API secret or Measurement Protocol secret in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_GA_ID=

# Careers application form (app/api/careers/route.ts). Server-side only —
# never prefix these with NEXT_PUBLIC_.
# TODO(business): create a Resend API key for a verified gamcs.in sending
# domain. Until it is set the route answers 503 and the form falls back to
# opening the applicant's own mail app addressed to careers@gamcs.in.
RESEND_API_KEY=
# Where applications are delivered. Default: careers@gamcs.in
CAREERS_TO_EMAIL=
# The From line; must be on the verified domain.
# Default: GAMCS Careers <careers@gamcs.in>
CAREERS_FROM_EMAIL=
