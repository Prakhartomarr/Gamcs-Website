/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files: the mail key lives in .env.local or the host's settings, never in git
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# isolated production build dir (NEXT_DIST_DIR)
.next-build/
.env.local

# internal working documents — not for a public repository.
# Globbed, not named: an exact filename only covered FINAL_2, so FINAL_3 and
# the v2 conversion were both staged for a public repo.
GAMCS_Website_Copy*.docx
*.docx
content.md
content-v*.md

# the generated site-copy document (content-doc/README.md stays tracked)
content-doc/*
!content-doc/README.md

# plugin cache
.impeccable/

# portrait pipeline: compiled Vision helpers and its working output
scripts/portraits/faces
scripts/portraits/segment
scripts/portraits/out/
scripts/portraits/.mask.png
__pycache__/
scripts/portraits/backdrop.png

# Screenshot baselines from the design audit — working output, not source.
design-audit/

# Agent tooling, not site code (2026-10-21). `.agents/` is 2.4MB of a skill
# installed from the GitHub repo in skills-lock.json — a dozen executable
# .mjs scripts that drive a headless browser for design work. It is tooling
# for whoever is editing the site, in the same category as node_modules:
# third-party code this project did not write and does not ship. The lock
# file records the source and a content hash, so `npx skills add` rebuilds
# it; keeping 2.4MB of someone else's scripts in a client's website repo
# buys nothing and means every clone carries them.
# .claude/launch.json stays tracked — that one IS this project's config.
.agents/
.claude/skills/
skills-lock.json
